# ==============================================================================
# AUTOMATED MULTI-PLATFORM POSTING SYSTEM (AMPPS) - ENVIRONMENT CONFIGURATION
# Copy this template to .env and configure credentials as needed.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Core Application Settings
APP_NAME="Automated Multi-Platform Posting System"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=4000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ==============================================================================
# THIRD-PARTY PLATFORM CREDENTIALS
# Optional for initial service startup and health checks.
# If omitted or empty, the platform adapter gracefully reports 'not configured'
# without interrupting other configured platforms.
# ==============================================================================

# 1. Telegram Bot API
# Create via @BotFather. chat_id can be @public_channel_name or numeric ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord Webhook API
# Create via Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# 3. Mastodon REST API
# Instance URL (e.g., https://mastodon.social).
# Access Token generated under Preferences -> Development -> New Application (scope: write:statuses).
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 4. Bluesky AT Protocol / XRPC
# User handle (e.g., yourname.bsky.social).
# App Password generated under Settings -> Advanced -> App Passwords.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# 5. Dev.to / Forem API
# API Key generated under dev.to/settings/extensions -> DEV Community API Keys.
DEVTO_API_KEY=
